APP_NAME=NexStay
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
# Production: https://nexstay.mernettechnologies.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Landlord connection (public schema). Tenant schemas share this database (PostgreSQL).
DB_CONNECTION=central
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=nexstay
DB_USERNAME=nexstay
DB_PASSWORD=nexstay
DB_SSLMODE=prefer

TENANCY_CENTRAL_CONNECTION=central

# Comma-separated hostnames for the central app. No subdomain routing needed —
# tenant is resolved from session (web) or Bearer token (API).
CENTRAL_DOMAINS=localhost,127.0.0.1
# Production: CENTRAL_DOMAINS=nexstay.mernettechnologies.com

SESSION_DRIVER=database
# Force sessions to use the central DB connection so they survive tenant schema switches.
SESSION_CONNECTION=central
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
# Production: SESSION_DOMAIN=nexstay.mernettechnologies.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=resend
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

NEXSTAY_DEFAULT_CURRENCY=TZS

TILL_VARIANCE_THRESHOLD=2000
TILL_REQUIRE_MANAGER_PIN=true
NEXSTAY_REPORT_EMAIL=
NEXSTAY_REPORT_SEND_TIME=08:00
NEXSTAY_REPORT_TIMEZONE=UTC+3

# Demo tenant — property_code used on the login form is DEMO_TENANT_ID ("demo").
# Run: php artisan nexstay:install-demo --migrate-central --seed
DEMO_TENANT_ID=demo
DEMO_ADMIN_EMAIL=admin@demo.local
DEMO_FRONT_DESK_EMAIL=frontdesk@demo.local
DEMO_HOUSEKEEPER_EMAIL=housekeeper@demo.local
DEMO_PASSWORD=NexStay2026!

# OpenAPI / Swagger UI (served on single domain: http://localhost:8000/api/documentation)
API_DOCS_ENABLED=true
API_DOCS_TENANT_HOST=http://localhost:8000
L5_SWAGGER_GENERATE_ALWAYS=true
L5_SWAGGER_CONST_HOST=http://localhost:8000

# Textify SMS
TEXTIFY_BASE_URL=https://portal.textify.africa/api
TEXTIFY_API_KEY=
TEXTIFY_SENDER_NAME=
TEXTIFY_DEFAULT_COUNTRY_CODE=255
